        private void LoadInitialData()
        {
            var initialData = new List<MemberModel>
            {
                new MemberModel { MemberId = "HV001", FullName = "Nguyễn Văn An", Phone = "0901234567", Package = "Theo tháng", StartDate = DateTime.Now.AddDays(-10), Fee = 500000 },
                new MemberModel { MemberId = "HV002", FullName = "Trần Thị Bình", Phone = "0987654321", Package = "6 tháng", StartDate = DateTime.Now.AddDays(-30), Fee = 2700000 }
            };

            memberList = new BindingList<MemberModel>(initialData);
            bindingSource.DataSource = memberList;
            dgvMembers.DataSource = bindingSource;

            autoIdCounter = 3; // Tiếp tục sinh từ HV003
        }

        private void GenerateNextMemberId()
        {
            txtMemberId.Text = $"HV{autoIdCounter:D3}";
        }

        // Kiểm tra hợp lệ dữ liệu bằng ErrorProvider theo đúng yêu cầu nghiệp vụ
        private bool ValidateInputs()
        {
            bool isValid = true;
            errorProvider.Clear();

            // 1. Tên hội viên không được để trống hoặc chứa ký tự đặc biệt
            // Cho phép chữ cái tiếng Việt, khoảng trắng. Ký tự đặc biệt hoặc số sẽ báo lỗi.
            string namePattern = @"^[a-zA-ZÀ-ỹ\s]+$";
            if (string.IsNullOrWhiteSpace(txtFullName.Text))
            {
                errorProvider.SetError(txtFullName, "Tên hội viên không được để trống.");
                isValid = false;
            }
            else if (!Regex.IsMatch(txtFullName.Text.Trim(), namePattern))
            {
                errorProvider.SetError(txtFullName, "Tên hội viên không được chứa ký tự đặc biệt hoặc số.");
                isValid = false;
            }

            // 2. Số điện thoại phải đúng 10 chữ số (bắt đầu bằng số 0)
            string phonePattern = @"^0\d{9}$";
            if (string.IsNullOrWhiteSpace(txtPhone.Text) || !Regex.IsMatch(txtPhone.Text.Trim(), phonePattern))
            {
                errorProvider.SetError(txtPhone, "Số điện thoại phải đúng 10 chữ số và bắt đầu bằng số 0.");
                isValid = false;
            }

            // 3. Phí dịch vụ phải là số nguyên dương
            if (!decimal.TryParse(txtFee.Text.Trim(), out decimal fee) || fee <= 0 || fee % 1 != 0)
            {
                errorProvider.SetError(txtFee, "Phí dịch vụ phải là một số nguyên dương (> 0).");
                isValid = false;
            }

            return isValid;
        }

        // Chức năng Thêm mới
        private void BtnAdd_Click(object sender, EventArgs e)
        {
            if (!ValidateInputs()) return;

            var newMember = new MemberModel
            {
                MemberId = txtMemberId.Text.Trim(),
                FullName = txtFullName.Text.Trim().ToUpper(),
                Phone = txtPhone.Text.Trim(),
                Package = cboPackage.SelectedItem.ToString(),
                StartDate = dtpStartDate.Value.Date,
                Fee = decimal.Parse(txtFee.Text.Trim())
            };

            memberList.Add(newMember);
            autoIdCounter++;
            GenerateNextMemberId();
            ClearInputFields(false); // Giữ lại mã mới sinh
            MessageBox.Show("Thêm hội viên thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        // Chức năng Sửa thông tin (Đồng bộ 2 chiều tự động)
        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (dgvMembers.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn hội viên cần sửa trên lưới.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateInputs()) return;

            // Lấy trực tiếp đối tượng đang được Bind trên dòng được chọn
            var selectedMember = (MemberModel)dgvMembers.SelectedRows[0].DataBoundItem;

            // Thay đổi dữ liệu trực tiếp trên Model -> Tự động đồng bộ lên BindingList và cập nhật ngay lên lưới
            selectedMember.FullName = txtFullName.Text.Trim();
            selectedMember.Phone = txtPhone.Text.Trim();
            selectedMember.Package = cboPackage.SelectedItem.ToString();
            selectedMember.StartDate = dtpStartDate.Value.Date;
            selectedMember.Fee = decimal.Parse(txtFee.Text.Trim());

            // Làm mới hiển thị binding
            bindingSource.ResetBindings(false);
            MessageBox.Show("Cập nhật thông tin hội viên thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        // Chức năng Xóa hội viên có hộp thoại xác nhận Yes/No (MessageBoxIcon.Warning)
        private void BtnDelete_Click(object sender, EventArgs e)
        {
            if (dgvMembers.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn hội viên cần xóa trên lưới.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var confirmResult = MessageBox.Show(
                "Bạn có chắc chắn muốn xóa hội viên này khỏi hệ thống?",
                "Xác nhận xóa",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            );

            if (confirmResult == DialogResult.Yes)
            {
                var selectedMember = (MemberModel)dgvMembers.SelectedRows[0].DataBoundItem;
                memberList.Remove(selectedMember);
                ClearInputFields(true);
                MessageBox.Show("Đã xóa hội viên thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        private void BtnClear_Click(object sender, EventArgs e)
        {
            ClearInputFields(true);
            dgvMembers.ClearSelection();
        }

        private void ClearInputFields(bool resetId)
        {
            if (resetId) GenerateNextMemberId();
            txtFullName.Clear();
            txtPhone.Clear();
            txtFee.Clear();
            if (cboPackage.Items.Count > 0) cboPackage.SelectedIndex = 0;
            dtpStartDate.Value = DateTime.Now;
            errorProvider.Clear();
        }

        // Đồng bộ 2 chiều: Chọn dòng trên dgvMembers điền thông tin lên Control
        private void DgvMembers_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                var member = (MemberModel)dgvMembers.Rows[e.RowIndex].DataBoundItem;
                txtMemberId.Text = member.MemberId;
                txtFullName.Text = member.FullName;
                txtPhone.Text = member.Phone;
                cboPackage.SelectedItem = member.Package;
                dtpStartDate.Value = member.StartDate;
                txtFee.Text = member.Fee.ToString("0");
                errorProvider.Clear();
            }
        }
    }

