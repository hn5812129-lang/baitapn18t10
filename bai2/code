        private void ClearForm()
        {
            txtBookId.Clear();
            txtTitle.Clear();
            txtAuthor.Clear();
            txtQuantity.Clear();
            txtPrice.Clear();
            txtBookId.Enabled = true;
            currentCoverPath = string.Empty;
            picBookCover.Image = null;
            errorProvider.Clear();
        }

        private void DgvBooks_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                var book = (BookModel)dgvBooks.Rows[e.RowIndex].DataBoundItem;
                txtBookId.Text = book.BookId;
                txtBookId.Enabled = false;
                txtTitle.Text = book.Title;
                txtAuthor.Text = book.Author;
                txtQuantity.Text = book.Quantity.ToString();
                txtPrice.Text = book.Price.ToString("0");

                currentCoverPath = book.CoverImagePath;
                if (!string.IsNullOrEmpty(currentCoverPath) && File.Exists(currentCoverPath))
                {
                    try { picBookCover.Image = Image.FromFile(currentCoverPath); }
                    catch { picBookCover.Image = null; }
                }
                else
                {
                    picBookCover.Image = null;
                }
                errorProvider.Clear();
            }
        }

        private void TxtSearch_TextChanged(object sender, EventArgs e)
        {
            string keyword = txtSearch.Text.Trim().ToLower();
            if (keyword == "nhập mã hoặc tên sách..." || string.IsNullOrEmpty(keyword))
            {
                bindingSource.DataSource = bookList;
            }
            else
            {
                var filtered = bookList.Where(x => x.BookId.ToLower().Contains(keyword) || x.Title.ToLower().Contains(keyword)).ToList();
                bindingSource.DataSource = new BindingList<BookModel>(filtered);
            }
            UpdateStatusStrip();
        }

        private void MenuSave_Click(object sender, EventArgs e)
        {
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*";
                sfd.FileName = $"DanhSachSach_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

                if (sfd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        using (StreamWriter sw = new StreamWriter(sfd.FileName, false, System.Text.Encoding.UTF8))
                        {
                            sw.WriteLine("BookId,Title,Author,Quantity,Price,CoverImagePath");
                            foreach (var item in bookList)
                            {
                                sw.WriteLine($"\"{item.BookId}\",\"{item.Title}\",\"{item.Author}\",{item.Quantity},{item.Price},\"{item.CoverImagePath}\"");
                            }
                        }
                        MessageBox.Show("Lưu file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi lưu file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }

        private void MenuOpen_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*";
                if (ofd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        var lines = File.ReadAllLines(ofd.FileName, System.Text.Encoding.UTF8);
                        var loadedList = new List<BookModel>();

                        for (int i = 1; i < lines.Length; i++)
                        {
                            if (string.IsNullOrWhiteSpace(lines[i])) continue;

                            var parts = lines[i].Split(new string[] { "\",\"" }, StringSplitOptions.None);
                            if (parts.Length >= 6)
                            {
                                string id = parts[0].Trim('"');
                                string title = parts[1].Trim('"');
                                string author = parts[2].Trim('"');
                                int.TryParse(parts[3], out int qty);
                                decimal.TryParse(parts[4], out decimal price);
                                string img = parts[5].Trim('"');

                                loadedList.Add(new BookModel { BookId = id, Title = title, Author = author, Quantity = qty, Price = price, CoverImagePath = img });
                            }
                        }

                        bookList = new BindingList<BookModel>(loadedList);
                        bindingSource.DataSource = bookList;
                        UpdateStatusStrip();
                        MessageBox.Show("Mở file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi đọc file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }

        private void UpdateStatusStrip()
        {
            int totalBooksCount = bookList.Count;
            decimal totalWarehouseValue = bookList.Sum(x => x.TotalValue);

            lblTotalBooks.Text = $"Tổng số đầu sách: {totalBooksCount}  |  ";
            lblTotalValue.Text = $"Tổng giá trị kho: {totalWarehouseValue:N0} ₫  |  ";
        }
