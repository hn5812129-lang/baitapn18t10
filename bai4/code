        // 1. Xử lý Thống kê bất đồng bộ bằng async/await & Task.Run
        private async void BtnAnalyze_Click(object? sender, EventArgs e)
        {
            // Khởi tạo CancellationTokenSource mới cho tác vụ
            cts = new CancellationTokenSource();

            // Cập nhật trạng thái UI
            btnAnalyze.Enabled = false;
            btnCancel.Enabled = true;
            pgbLoading.Value = 0;
            lblProcessingStatus.ForeColor = Color.Blue;
            lblProcessingStatus.Text = "Đang kết nối cơ sở dữ liệu và truy xuất bản ghi...";

            // Làm sạch kết quả cũ
            resultList.Clear();

            // Tạo Progress đối tượng để Background Thread báo cáo trạng thái an toàn lên UI Thread
            var progress = new Progress<ProgressReport>(report =>
            {
                pgbLoading.Value = report.Percentage;
                lblProcessingStatus.Text = report.StatusMessage;
            });

            string selectedBranch = cmbBranch.SelectedItem?.ToString() ?? "Tất cả chi nhánh";
            DateTime fromDate = dtpFromDate.Value.Date;
            DateTime toDate = dtpToDate.Value.Date;

            try
            {
                // Đẩy tác vụ nặng xuống Background Thread bằng Task.Run và chờ kết quả bằng await
                List<RevenueTransaction> data = await Task.Run(() => FetchAndAggregateData(selectedBranch, fromDate, toDate, progress, cts.Token), cts.Token);

                // Nạp kết quả lên lưới hiển thị
                foreach (var item in data)
                {
                    resultList.Add(item);
                }

                lblProcessingStatus.ForeColor = Color.Green;
                lblProcessingStatus.Text = $"Thống kê thành công! Tổng số giao dịch: {resultList.Count} | Tổng doanh thu: {resultList.Sum(x => x.Amount):N0} ₫";
            }
            catch (OperationCanceledException)
            {
                // Xử lý khi người dùng nhấn Hủy
                pgbLoading.Value = 0;
                lblProcessingStatus.ForeColor = Color.Red;
                lblProcessingStatus.Text = "Đã hủy thao tác thống kê!";
            }
            catch (Exception ex)
            {
                lblProcessingStatus.ForeColor = Color.Red;
                lblProcessingStatus.Text = $"Lỗi trong quá trình xử lý: {ex.Message}";
            }
            finally
            {
                // Khôi phục trạng thái nút bấm
                btnAnalyze.Enabled = true;
                btnCancel.Enabled = false;
                cts.Dispose();
                cts = null;
            }
        }

        // 2. Hủy tác vụ bất đồng bộ bằng CancellationTokenSource
        private void BtnCancel_Click(object? sender, EventArgs e)
        {
            if (cts != null && !cts.IsCancellationRequested)
            {
                lblProcessingStatus.ForeColor = Color.OrangeRed;
                lblProcessingStatus.Text = "Đang gửi yêu cầu hủy thao tác...";
                cts.Cancel(); // Ngắt tác vụ ngầm
            }
        }

        // Tác vụ giả lập tổng hợp CSDL nặng (chạy ở Background Thread)
        private List<RevenueTransaction> FetchAndAggregateData(string branch, DateTime from, DateTime to, IProgress<ProgressReport> progress, CancellationToken token)
        {
            var list = new List<RevenueTransaction>();
            Random rand = new Random();

            // Giả lập 5 giai đoạn xử lý tổng cộng mất 5 giây (mỗi giai đoạn 1s)
            for (int i = 1; i <= 5; i++)
            {
                // Bắt buộc kiểm tra yêu cầu hủy
                token.ThrowIfCancellationRequested();

                // Giả lập tính toán/truy xuất nặng trong 1000ms
                Thread.Sleep(1000);

                int percent = i * 20;
                string statusMsg = i switch
                {
                    1 => "Đang tải dữ liệu giao dịch từ máy chủ chi nhánh... (20%)",
                    2 => "Đang tính toán tổng hợp chỉ số doanh thu... (40%)",
                    3 => "Đang lọc điều kiện ngày và danh mục thanh toán... (60%)",
                    4 => "Đang kiểm tra tính toàn vẹn của tập bản ghi... (80%)",
                    5 => "Hoàn tất tổng hợp dữ liệu! Đang tải lên giao diện... (100%)",
                    _ => $"Đang xử lý... ({percent}%)"
                };

                // Báo cáo tiến độ về UI Thread
                progress.Report(new ProgressReport { Percentage = percent, StatusMessage = statusMsg });
            }

            token.ThrowIfCancellationRequested();

            // Sinh dữ liệu mẫu ngẫu nhiên
            string[] customers = { "Công ty CP Hoàng Gia", "Nguyễn Minh Châu", "Trần Quang Khải", "Tập đoàn Nam Long", "Phạm Quốc Bảo" };
            string[] methods = { "Chuyển khoản ngân hàng", "Thẻ tín dụng", "Tiền mặt", "Ví Điện tử MoMo" };
            string[] branches = { "Chi nhánh Hà Nội", "Chi nhánh TP.HCM", "Chi nhánh Đà Nẵng", "Chi nhánh Cần Thơ" };

            int totalRecords = rand.Next(15, 30);
            for (int i = 1; i <= totalRecords; i++)
            {
                string bName = branch == "Tất cả chi nhánh" ? branches[rand.Next(branches.Length)] : branch;
                list.Add(new RevenueTransaction
                {
                    TransactionId = $"GD{10000 + i}",
                    TransactionDate = from.AddDays(rand.Next(0, Math.Max(1, (int)(to - from).TotalDays))),
                    BranchName = bName,
                    CustomerName = customers[rand.Next(customers.Length)],
                    Amount = rand.Next(500, 50000) * 1000,
                    PaymentMethod = methods[rand.Next(methods.Length)]
                });
            }

            return list;
        }
    }

    // Điểm khởi chạy ứng dụng
    static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
