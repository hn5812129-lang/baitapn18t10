using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Drawing;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace RevenueAnalyticsApp
{
    // Lớp dữ liệu Giao dịch doanh thu
    public class RevenueTransaction
    {
        public string TransactionId { get; set; } = string.Empty; // Mã giao dịch
        public DateTime TransactionDate { get; set; }            // Ngày giao dịch
        public string BranchName { get; set; } = string.Empty;   // Chi nhánh
        public string CustomerName { get; set; } = string.Empty; // Khách hàng
        public decimal Amount { get; set; }                       // Số tiền
        public string PaymentMethod { get; set; } = string.Empty; // Phương thức thanh toán
    }

    // Class báo cáo tiến độ công việc
    public class ProgressReport
    {
        public int Percentage { get; set; }
        public string StatusMessage { get; set; } = string.Empty;
    }

    public partial class frmRevenueAnalytics : Form
    {
        // Controls trên giao diện
        private TableLayoutPanel mainLayout = null!;
        private GroupBox grpCriteria = null!;
        private GroupBox grpStatus = null!;
        private DateTimePicker dtpFromDate = null!;
        private DateTimePicker dtpToDate = null!;
        private ComboBox cmbBranch = null!;
        private Button btnAnalyze = null!;
        private Button btnCancel = null!;
        private ProgressBar pgbLoading = null!;
        private Label lblProcessingStatus = null!;
        private DataGridView dgvRevenueData = null!;

        private BindingList<RevenueTransaction> resultList = new BindingList<RevenueTransaction>();
        private BindingSource bindingSource = new BindingSource();

        // Quản lý việc hủy tác vụ bất đồng bộ
        private CancellationTokenSource? cts;

        public frmRevenueAnalytics()
        {
            InitializeComponentCustom();
        }

        private void InitializeComponentCustom()
        {
            this.Text = "Bảng điều khiển Thống kê Doanh thu Multi-Threading (Async/Await)";
            this.Size = new Size(1000, 700);
            this.StartPosition = FormStartPosition.CenterScreen;

            // Main TableLayoutPanel
            mainLayout = new TableLayoutPanel();
            mainLayout.Dock = DockStyle.Fill;
            mainLayout.ColumnCount = 1;
            mainLayout.RowCount = 3;
            mainLayout.RowStyles.Add(new RowStyle(SizeType.Absolute, 100f)); // Khu vực tiêu chí
            mainLayout.RowStyles.Add(new RowStyle(SizeType.Absolute, 70f));  // Khu vực tiến độ
            mainLayout.RowStyles.Add(new RowStyle(SizeType.Percent, 100f)); // DataGridView
            this.Controls.Add(mainLayout);

            // --- VÙNG 1: TIÊU CHÍ LỌC & NÚT THAO TÁC ---
            grpCriteria = new GroupBox { Text = "Tiêu chí thống kê", Dock = DockStyle.Fill };
            FlowLayoutPanel criteriaPanel = new FlowLayoutPanel { Dock = DockStyle.Fill, Padding = new Padding(5) };

            dtpFromDate = new DateTimePicker { Format = DateTimePickerFormat.Short, Width = 110, Value = DateTime.Now.AddDays(-30) };
            dtpToDate = new DateTimePicker { Format = DateTimePickerFormat.Short, Width = 110, Value = DateTime.Now };

            cmbBranch = new ComboBox { Width = 160, DropDownStyle = ComboBoxStyle.DropDownList };
            cmbBranch.Items.AddRange(new string[] { "Tất cả chi nhánh", "Chi nhánh Hà Nội", "Chi nhánh TP.HCM", "Chi nhánh Đà Nẵng", "Chi nhánh Cần Thơ" });
            cmbBranch.SelectedIndex = 0;

            btnAnalyze = new Button { Text = "Thống Kê Doanh Thu", Width = 150, Height = 30, BackColor = Color.LightSkyBlue, FlatStyle = FlatStyle.Flat };
            btnCancel = new Button { Text = "Hủy Thao Tác", Width = 110, Height = 30, Enabled = false, BackColor = Color.MistyRose, FlatStyle = FlatStyle.Flat };

            btnAnalyze.Click += BtnAnalyze_Click;
            btnCancel.Click += BtnCancel_Click;

            criteriaPanel.Controls.AddRange(new Control[] {
                new Label { Text = "Từ ngày:", Padding = new Padding(0, 6, 0, 0) }, dtpFromDate,
                new Label { Text = "Đến ngày:", Padding = new Padding(10, 6, 0, 0) }, dtpToDate,
                new Label { Text = "Chi nhánh:", Padding = new Padding(10, 6, 0, 0) }, cmbBranch,
                btnAnalyze, btnCancel
            });

            grpCriteria.Controls.Add(criteriaPanel);
            mainLayout.Controls.Add(grpCriteria, 0, 0);

            // --- VÙNG 2: TIẾN ĐỘ VÀ TRẠNG THÁI (PROGRESSBAR & LABEL) ---
            grpStatus = new GroupBox { Text = "Trạng thái tiến trình", Dock = DockStyle.Fill };
            TableLayoutPanel statusPanel = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 2, Padding = new Padding(5) };

            pgbLoading = new ProgressBar { Dock = DockStyle.Fill, Minimum = 0, Maximum = 100, Value = 0 };
            lblProcessingStatus = new Label { Text = "Sẵn sàng thực hiện thống kê.", Dock = DockStyle.Fill, TextAlign = ContentAlignment.MiddleLeft, ForeColor = Color.DarkGray };

            statusPanel.Controls.Add(pgbLoading, 0, 0);
            statusPanel.Controls.Add(lblProcessingStatus, 0, 1);
            grpStatus.Controls.Add(statusPanel);
            mainLayout.Controls.Add(grpStatus, 0, 1);

            // --- VÙNG 3: DATAGRIDVIEW KẾT QUẢ ---
            dgvRevenueData = new DataGridView
