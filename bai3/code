        // --- HÀM NGHỆP VỤ: MỞ FORM CON VÀ CHỐNG MỞ LẶP LAI (DUPLICATE) ---
        private void OpenChildForm<T>() where T : Form, new()
        {
            // Duyệt qua danh sách MdiChildren hiện tại
            foreach (Form child in this.MdiChildren)
            {
                // Nếu Form kiểu T đã được mở -> Kích hoạt Form đó lên trên cùng
                if (child is T)
                {
                    child.Activate();
                    if (child.WindowState == FormWindowState.Minimized)
                    {
                        child.WindowState = FormWindowState.Normal;
                    }
                    return;
                }
            }

            // Nếu Form chưa mở -> Khởi tạo Instance mới, gán MdiParent = this và Show()
            T newChildForm = new T
            {
                MdiParent = this
            };
            newChildForm.Show();
        }

        // Đóng tất cả cửa sổ con
        private void CloseAllChildForms()
        {
            foreach (Form child in this.MdiChildren)
            {
                child.Close();
            }
        }

        private void Logout()
        {
            MessageBox.Show("Đã đăng xuất khỏi hệ thống thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            CloseAllChildForms();
        }

        private void ReloadData()
        {
            progressBar.Value = 30;
            System.Threading.Thread.Sleep(200);
            progressBar.Value = 100;
            MessageBox.Show("Nạp lại dữ liệu hệ thống thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }
    }


